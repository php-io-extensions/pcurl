{
    "name": "php-io-extensions/pcurl",
    "type": "php-ext",
    "description": "libcurl's multi socket API bound 1:1 into PHP on top of ext-curl handles",
    "license": "MIT",
    "version": "0.11.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "php-ext": {
        "extension-name": "pcurl",
        "priority": 40,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families-exclude": [
            "windows"
        ],
        "configure-options": [
            {
                "name": "enable-pcurl",
                "description": "Enable the pcurl extension",
                "needs-value": false
            }
        ]
    },
    "extra": {
        "venusian": {
            "system": {
                "apt": {
                    "build": [
                        "libcurl4-openssl-dev"
                    ]
                },
                "brew": {
                    "build": [
                        "curl"
                    ]
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
